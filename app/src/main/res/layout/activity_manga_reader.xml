<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/masumi_reader_background">

    <rs.masumi.app.library.ContinuousReaderView
        android:id="@+id/readerContinuous"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:contentDescription="@string/reader_page_content_description" />

    <LinearLayout
        android:id="@+id/readerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/masumi_reader_chrome"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="40dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <Button
            android:id="@+id/readerCloseButton"
            style="@style/Widget.Masumi.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reader_close" />

        <Button
            android:id="@+id/readerRestartButton"
            style="@style/Widget.Masumi.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="@string/reader_restart" />

        <TextView
            android:id="@+id/readerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/masumi_reader_chrome_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/readerStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/reader_loading"
            android:textColor="@color/masumi_reader_chrome_text"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/readerJumpInput"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:hint="@string/reader_jump_hint"
            android:imeOptions="actionGo"
            android:inputType="number"
            android:maxLength="5"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:textColor="@color/masumi_reader_chrome_text"
            android:textColorHint="@color/masumi_reader_chrome_text"
            android:textSize="14sp" />

        <Button
            android:id="@+id/readerJumpButton"
            style="@style/Widget.Masumi.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:minWidth="56dp"
            android:text="@string/reader_jump" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/readerBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/masumi_reader_chrome"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp">

        <SeekBar
            android:id="@+id/readerSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>
</FrameLayout>
