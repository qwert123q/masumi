<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission
        android:name="${applicationId}.permission.INTERNAL_DETECTION_STATUS"
        android:protectionLevel="signature" />
    <permission
        android:name="${applicationId}.permission.INTERNAL_OCR_STATUS"
        android:protectionLevel="signature" />
    <permission
        android:name="${applicationId}.permission.INTERNAL_TRANSLATION_STATUS"
        android:protectionLevel="signature" />
    <permission
        android:name="${applicationId}.permission.INTERNAL_CLEANUP_STATUS"
        android:protectionLevel="signature" />
    <permission
        android:name="${applicationId}.permission.INTERNAL_TYPESETTING_STATUS"
        android:protectionLevel="signature" />
    <permission
        android:name="${applicationId}.permission.INTERNAL_QUALITY_STATUS"
        android:protectionLevel="signature" />
    <permission
        android:name="${applicationId}.permission.INTERNAL_EXPORT_STATUS"
        android:protectionLevel="signature" />

    <uses-permission android:name="${applicationId}.permission.INTERNAL_DETECTION_STATUS" />
    <uses-permission android:name="${applicationId}.permission.INTERNAL_OCR_STATUS" />
    <uses-permission android:name="${applicationId}.permission.INTERNAL_TRANSLATION_STATUS" />
    <uses-permission android:name="${applicationId}.permission.INTERNAL_CLEANUP_STATUS" />
    <uses-permission android:name="${applicationId}.permission.INTERNAL_TYPESETTING_STATUS" />
    <uses-permission android:name="${applicationId}.permission.INTERNAL_QUALITY_STATUS" />
    <uses-permission android:name="${applicationId}.permission.INTERNAL_EXPORT_STATUS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Masumi">
        <activity
            android:name=".library.LibraryActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".library.MangaReaderActivity"
            android:exported="false" />
        <service
            android:name=".detection.DetectionForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />
        <service
            android:name=".ocr.OcrForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:process=":ocr"
            android:stopWithTask="false" />
        <service
            android:name=".translation.TranslationForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />
        <service
            android:name=".cleanup.CleanupForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />
        <service
            android:name=".typesetting.TypesettingForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />
        <service
            android:name=".quality.QualityForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />
        <service
            android:name=".exporting.ExportForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />
    </application>
</manifest>
