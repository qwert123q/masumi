<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application android:usesCleartextTraffic="true">
        <service
            android:name="rs.masumi.app.detection.DetectionForegroundService"
            android:exported="true"
            android:foregroundServiceType="dataSync"
            android:permission="android.permission.DUMP"
            android:stopWithTask="false"
            tools:replace="android:exported" />
        <service
            android:name="rs.masumi.app.ocr.OcrForegroundService"
            android:exported="true"
            android:foregroundServiceType="dataSync"
            android:permission="android.permission.DUMP"
            android:process=":ocr"
            android:stopWithTask="false"
            tools:replace="android:exported" />
        <service
            android:name="rs.masumi.app.translation.TranslationForegroundService"
            android:exported="true"
            android:foregroundServiceType="dataSync"
            android:permission="android.permission.DUMP"
            android:stopWithTask="false"
            tools:replace="android:exported" />
        <service
            android:name="rs.masumi.app.cleanup.CleanupForegroundService"
            android:exported="true"
            android:foregroundServiceType="dataSync"
            android:permission="android.permission.DUMP"
            android:stopWithTask="false"
            tools:replace="android:exported" />
        <service
            android:name="rs.masumi.app.typesetting.TypesettingForegroundService"
            android:exported="true"
            android:foregroundServiceType="dataSync"
            android:permission="android.permission.DUMP"
            android:stopWithTask="false"
            tools:replace="android:exported" />
        <service
            android:name="rs.masumi.app.quality.QualityForegroundService"
            android:exported="true"
            android:foregroundServiceType="dataSync"
            android:permission="android.permission.DUMP"
            android:stopWithTask="false"
            tools:replace="android:exported" />
        <service
            android:name="rs.masumi.app.exporting.ExportForegroundService"
            android:exported="true"
            android:foregroundServiceType="dataSync"
            android:permission="android.permission.DUMP"
            android:stopWithTask="false"
            tools:replace="android:exported" />
        <provider
            android:name="rs.masumi.app.TestDocumentsProvider"
            android:authorities="rs.masumi.app.dev.test.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS" />
    </application>
</manifest>
